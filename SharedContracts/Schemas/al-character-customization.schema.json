{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://another-life.local/schemas/al-character-customization.schema.json",
  "title": "Another Life Character Customization Catalog",
  "type": "object",
  "required": ["version", "game", "characterSlots", "realms", "qualityTargets"],
  "properties": {
    "version": {
      "type": "string"
    },
    "game": {
      "type": "string"
    },
    "characterSlots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "realms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/realmCustomization"
      },
      "minItems": 1
    },
    "qualityTargets": {
      "$ref": "#/$defs/qualityTargets"
    }
  },
  "$defs": {
    "realmCustomization": {
      "type": "object",
      "required": ["id", "displayName", "materialKeys", "customizationFocus"],
      "properties": {
        "id": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "materialKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "customizationFocus": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "qualityTargets": {
      "type": "object",
      "required": ["heroTriangles", "mediumTriangles", "lowTriangles", "farRepresentation"],
      "properties": {
        "heroTriangles": {
          "type": "string"
        },
        "mediumTriangles": {
          "type": "string"
        },
        "lowTriangles": {
          "type": "string"
        },
        "farRepresentation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

