  "motionRules": [
    {
      "id": "rmc_motion_rule_locomotion_cycle_v001",
      "pattern": "^locomotion\\.(crawl|fly|run|sprint|strafe_l|strafe_r|swim|turn|walk)$",
      "style": "locomotion_cycle",
      "durationFrames": 24,
      "loop": true,
      "rootTreatment": "in_place_motor_owned",
      "eventTemplate": "contact_cycle"
    },
    {
      "id": "rmc_motion_rule_idle_cycle_v001",
      "pattern": "^idle\\..+$",
      "style": "idle_cycle",
      "durationFrames": 60,
      "loop": true,
      "rootTreatment": "in_place_motor_owned",
      "eventTemplate": "phase_loop"
    },
    {
      "id": "rmc_motion_rule_channel_cycle_v001",
      "pattern": "^skill\\.channel_loop$",
      "style": "channel_cycle",
      "durationFrames": 36,
      "loop": true,
      "rootTreatment": "in_place_motor_owned",
      "eventTemplate": "phase_loop"
    },
    {
      "id": "rmc_motion_rule_attack_v001",
      "pattern": "^(attack\\..+|skill\\.(cast|commit|impact|release)|interaction\\.cut)$",
      "style": "attack_action",
      "durationFrames": 30,
      "loop": false,
      "rootTreatment": "in_place_motor_owned",
      "eventTemplate": "attack_window"
    },
    {
      "id": "rmc_motion_rule_collapse_v001",
      "pattern": "^(defeat|reaction\\.knockdown)$",
      "style": "collapse_action",
      "durationFrames": 36,
      "loop": false,
      "rootTreatment": "in_place_motor_owned",
      "eventTemplate": "phase_once"
    },
    {
      "id": "rmc_motion_rule_rise_v001",
      "pattern": "^reaction\\.get_up$",
      "style": "rise_action",
      "durationFrames": 36,
      "loop": false,
      "rootTreatment": "in_place_motor_owned",
      "eventTemplate": "phase_once"
    },
    {
      "id": "rmc_motion_rule_jump_v001",
      "pattern": "^locomotion\\.(jump|land)$",
      "style": "vertical_action",
      "durationFrames": 24,
      "loop": false,
      "rootTreatment": "vertical_root_visual_horizontal_motor",
      "eventTemplate": "phase_once"
    },
    {
      "id": "rmc_motion_rule_life_cycle_v001",
      "pattern": "^(daily\\.sleep|social\\.talk)$",
      "style": "idle_cycle",
      "durationFrames": 60,
      "loop": true,
      "rootTreatment": "in_place_motor_owned",
      "eventTemplate": "phase_loop"
    },
    {
      "id": "rmc_motion_rule_fall_cycle_v001",
      "pattern": "^locomotion\\.fall$",
      "style": "vertical_action",
      "durationFrames": 24,
      "loop": true,
      "rootTreatment": "vertical_root_visual_horizontal_motor",
      "eventTemplate": "phase_loop"
    },
    {
      "id": "rmc_motion_rule_generic_v001",
      "pattern": ".*",
      "style": "gesture_action",
      "durationFrames": 30,
      "loop": false,
      "rootTreatment": "in_place_motor_owned",
      "eventTemplate": "phase_once"
    }
  ],
  "eventTemplates": {
    "phase_once": [
      {
        "eventName": "al.motion.phase.enter",
        "normalizedTime": 0.0
      },
      {
        "eventName": "al.motion.interruptible.begin",
        "normalizedTime": 0.7
      },
      {
        "eventName": "al.motion.phase.exit",
        "normalizedTime": 1.0
      }
    ],
    "phase_loop": [
      {
        "eventName": "al.motion.phase.enter",
        "normalizedTime": 0.0
      },
      {
        "eventName": "al.motion.phase.exit",
        "normalizedTime": 1.0
      }
    ],
    "contact_cycle": [
      {
        "eventName": "al.motion.phase.enter",
        "normalizedTime": 0.0
      },
      {
        "eventName": "al.motion.contact.begin",
        "normalizedTime": 0.2,
        "contactIndex": 0
      },
      {
        "eventName": "al.motion.contact.end",
        "normalizedTime": 0.3,
        "contactIndex": 0
      },
      {
        "eventName": "al.motion.contact.begin",
        "normalizedTime": 0.7,
        "contactIndex": 1
      },
      {
        "eventName": "al.motion.contact.end",
        "normalizedTime": 0.8,
        "contactIndex": 1
      },
      {
        "eventName": "al.motion.phase.exit",
        "normalizedTime": 1.0
      }
    ],
    "attack_window": [
      {
        "eventName": "al.motion.phase.enter",
        "normalizedTime": 0.0
      },
      {
        "eventName": "al.motion.hitbox.request_begin",
        "normalizedTime": 0.36,
        "windowId": "primary"
      },
      {
        "eventName": "al.motion.hitbox.request_end",
        "normalizedTime": 0.62,
        "windowId": "primary"
      },
      {
        "eventName": "al.motion.interruptible.begin",
        "normalizedTime": 0.72,
        "windowId": "recovery"
      },
      {
        "eventName": "al.motion.phase.exit",
        "normalizedTime": 1.0
      }
    ]
  },
  "cleanupThresholds": {
    "maximumLoopPositionErrorMeters": 0.01,
    "maximumLoopRotationErrorDegrees": 1.0,
    "maximumContactDriftMeters": 0.02,
    "maximumTransitionPositionDeltaMeters": 0.03,
    "maximumTransitionRotationDeltaDegrees": 6.0
  }
}
