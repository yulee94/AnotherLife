{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anotherlife.local/schemas/terrestrial/faultroad-escarpment-visual-source/1.0.0",
  "title": "AnotherLife Faultroad Escarpment Visual Source Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packetId",
    "sourceVersion",
    "parentRosterSourceVersion",
    "createdDate",
    "promptDocument",
    "authority",
    "readiness",
    "generator",
    "sourceBudgets",
    "habitat",
    "placementReference",
    "environmentKit",
    "productionEnvelope",
    "sourceAssets",
    "generationRecords",
    "externalInputs"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "packetId": {"const": "tdf_packet_faultroad_escarpment_visual_source_v001"},
    "sourceVersion": {"const": "tdf-eco-faultroad-2026-07-27-v001"},
    "parentRosterSourceVersion": {"const": "tdf-eco-2026-07-27-v001"},
    "createdDate": {"type": "string", "format": "date"},
    "promptDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "const": "unity/Docs/Terrestrials/Ecosystems/FaultroadEscarpment/Executed_Generation_Prompts_And_Provenance.md"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terrestrialDesignSource",
        "runtime",
        "gameplay",
        "narrative",
        "save",
        "userCreativeApproval"
      ],
      "properties": {
        "terrestrialDesignSource": {"const": true},
        "runtime": {"const": false},
        "gameplay": {"const": false},
        "narrative": {"const": false},
        "save": {"const": false},
        "userCreativeApproval": {"const": false}
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "technicalPacketState",
        "userCreativeState",
        "runtimeIntegrationState",
        "narrativeNamingState",
        "visualQaState"
      ],
      "properties": {
        "technicalPacketState": {"const": "TechnicalReviewReady"},
        "userCreativeState": {"const": "NotRequested"},
        "runtimeIntegrationState": {"const": "Blocked"},
        "narrativeNamingState": {"const": "WorkingLabelsOnly"},
        "visualQaState": {"const": "PassWithConcern"}
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "versionOrModel",
        "externalInputsSupplied",
        "existingProjectReferenceSupplied",
        "editableSourceAvailable",
        "licenseRecordId"
      ],
      "properties": {
        "product": {"const": "Codex built-in image generation"},
        "versionOrModel": {"const": "unavailable_to_operator"},
        "externalInputsSupplied": {"const": false},
        "existingProjectReferenceSupplied": {"const": true},
        "editableSourceAvailable": {"const": false},
        "licenseRecordId": {"const": "tdf_license_codex_imagegen_generated_original_v001"}
      }
    },
    "sourceBudgets": {"$ref": "#/$defs/sourceBudgets"},
    "habitat": {"$ref": "#/$defs/habitat"},
    "placementReference": {"$ref": "#/$defs/placementReference"},
    "environmentKit": {"$ref": "#/$defs/environmentKit"},
    "productionEnvelope": {"$ref": "#/$defs/productionEnvelope"},
    "sourceAssets": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/sourceAsset"}
    },
    "generationRecords": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/generationRecord"}
    },
    "externalInputs": {
      "type": "array",
      "maxItems": 0
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "positiveRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {"type": "number", "minimum": 0},
        "maximum": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "sourceBudgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "ceilings", "actual"],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mediaType",
            "pixelWidth",
            "pixelHeight",
            "colorSpace",
            "bitDepth",
            "alphaPolicy",
            "maximumCompressedBytes",
            "estimatedDecodedRgbBytes",
            "maximumDecodedRgbaBytes",
            "maximumSimultaneousReviewImages",
            "maximumSimultaneousDecodedBytes"
          ],
          "properties": {
            "mediaType": {"const": "image/png"},
            "pixelWidth": {"const": 1536},
            "pixelHeight": {"const": 1024},
            "colorSpace": {"const": "sRGB"},
            "bitDepth": {"const": 8},
            "alphaPolicy": {"const": "opaque_rgb"},
            "maximumCompressedBytes": {"const": 4194304},
            "estimatedDecodedRgbBytes": {"const": 4718592},
            "maximumDecodedRgbaBytes": {"const": 6291456},
            "maximumSimultaneousReviewImages": {"const": 3},
            "maximumSimultaneousDecodedBytes": {"const": 18874368}
          }
        },
        "ceilings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "finalCount",
            "finalBytes",
            "retainedInputCount",
            "retainedInputBytes",
            "waveBytes"
          ],
          "properties": {
            "finalCount": {"const": 3},
            "finalBytes": {"const": 12582912},
            "retainedInputCount": {"const": 1},
            "retainedInputBytes": {"const": 4194304},
            "waveBytes": {"const": 16777216}
          }
        },
        "actual": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "finalCount",
            "finalBytes",
            "retainedInputCount",
            "retainedInputBytes",
            "totalCount",
            "totalBytes",
            "playerBuildBytes",
            "runtimeResidentBytes"
          ],
          "properties": {
            "finalCount": {"const": 3},
            "finalBytes": {"const": 8371959},
            "retainedInputCount": {"const": 1},
            "retainedInputBytes": {"const": 3048372},
            "totalCount": {"const": 4},
            "totalBytes": {"const": 11420331},
            "playerBuildBytes": {"const": 0},
            "runtimeResidentBytes": {"const": 0}
          }
        }
      }
    },
    "habitat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "habitatId",
        "realmId",
        "state",
        "qaDisposition",
        "userDecision",
        "environmentKitId",
        "landmarkId",
        "protectedIdentity",
        "neighborHabitatIds",
        "materialFamilyIds",
        "primaryAssetIds"
      ],
      "properties": {
        "habitatId": {"const": "tdf_habitat_stonehold_faultroad_escarpment"},
        "realmId": {"const": "stonehold"},
        "state": {"const": "ReadyForUserReview"},
        "qaDisposition": {"const": "PassWithConcern"},
        "userDecision": {"const": "NotRequested"},
        "environmentKitId": {"const": "tdf_envkit_stonehold_faultroad_escarpment"},
        "landmarkId": {"const": "tdf_landmark_stonehold_faultroad_fractured_crown"},
        "protectedIdentity": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableId"}
        },
        "neighborHabitatIds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableId"}
        },
        "materialFamilyIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/stableId"}
        },
        "primaryAssetIds": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableId"}
        }
      }
    },
    "placementReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "sourceVersion",
        "state",
        "qaDisposition",
        "assetId",
        "assetPath",
        "assetSha256",
        "usage"
      ],
      "properties": {
        "profileId": {"const": "tdf_basalt_grazer"},
        "sourceVersion": {"const": "tdf-foundation-fauna-normalization-2026-07-27-v001"},
        "state": {"const": "ReadyForUserReview"},
        "qaDisposition": {"const": "PassWithConcern"},
        "assetId": {"const": "tdf_asset_basalt_grazer_concept_sheet_v001"},
        "assetPath": {
          "const": "unity/Assets/AL/Art/Terrestrials/ConceptSheets/tdf_basalt_grazer_concept_sheet_v001.png"
        },
        "assetSha256": {"$ref": "#/$defs/sha256"},
        "usage": {"const": "identity_scale_contact_reference_only_no_spawn_authority"}
      }
    },
    "environmentKit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kitId",
        "propFamilyIds",
        "requiredParticles",
        "requiredDynamicLights",
        "requiredWaterFamilies"
      ],
      "properties": {
        "kitId": {"const": "tdf_envkit_stonehold_faultroad_escarpment"},
        "propFamilyIds": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableId"}
        },
        "requiredParticles": {"const": 0},
        "requiredDynamicLights": {"const": 0},
        "requiredWaterFamilies": {"const": 0}
      }
    },
    "productionEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "lowMobileUniqueCompressedTargetMiB",
        "hardParentCeilingMiB",
        "preferredSharedMaterialInstances",
        "maximumSimultaneousMaterialFamilies",
        "lod1RatioPercent",
        "lod2RatioPercent",
        "distantRatioPercent"
      ],
      "properties": {
        "status": {"const": "ProvisionalSourceTarget"},
        "lowMobileUniqueCompressedTargetMiB": {"$ref": "#/$defs/positiveRange"},
        "hardParentCeilingMiB": {"type": "number", "exclusiveMinimum": 0},
        "preferredSharedMaterialInstances": {"type": "integer", "minimum": 1},
        "maximumSimultaneousMaterialFamilies": {"type": "integer", "minimum": 1},
        "lod1RatioPercent": {"$ref": "#/$defs/positiveRange"},
        "lod2RatioPercent": {"$ref": "#/$defs/positiveRange"},
        "distantRatioPercent": {"$ref": "#/$defs/positiveRange"}
      }
    },
    "sourceAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "path",
        "roles",
        "state",
        "qaDisposition",
        "byteLength",
        "sha256",
        "gitLfsOid",
        "gitLfsSize",
        "generationRecordId"
      ],
      "properties": {
        "assetId": {"$ref": "#/$defs/stableId"},
        "path": {
          "type": "string",
          "pattern": "^unity/Docs/Terrestrials/Ecosystems/FaultroadEscarpment/(ConceptSheets|GenerationInputs)/[a-z0-9_]+\\.png$"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableId"}
        },
        "state": {
          "enum": ["ReadyForUserReview", "SupersededRetainedInput"]
        },
        "qaDisposition": {
          "enum": [
            "PassWithConcern",
            "ProvisionalPass",
            "RejectedForConstructedLedgeRead"
          ]
        },
        "byteLength": {"type": "integer", "minimum": 1, "maximum": 4194304},
        "sha256": {"$ref": "#/$defs/sha256"},
        "gitLfsOid": {"$ref": "#/$defs/sha256"},
        "gitLfsSize": {"type": "integer", "minimum": 1, "maximum": 4194304},
        "generationRecordId": {"$ref": "#/$defs/stableId"}
      }
    },
    "generationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generationRecordId",
        "outputAssetId",
        "inputAssetIds",
        "promptSection"
      ],
      "properties": {
        "generationRecordId": {"$ref": "#/$defs/stableId"},
        "outputAssetId": {"$ref": "#/$defs/stableId"},
        "inputAssetIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableId"}
        },
        "promptSection": {"type": "string", "minLength": 1}
      }
    }
  }
}
