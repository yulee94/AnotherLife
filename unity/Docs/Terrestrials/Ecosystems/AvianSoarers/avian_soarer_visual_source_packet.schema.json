{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anotherlife.local/schemas/terrestrial/avian-soarer-visual-source/1.0.0",
  "title": "AnotherLife Avian Soarer Visual Source Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packetId",
    "sourceVersion",
    "parentRosterSourceVersion",
    "createdAtUtc",
    "promptDocument",
    "authority",
    "readiness",
    "generator",
    "comparisonAnchor",
    "sourceBudgets",
    "profiles",
    "productionEnvelopes",
    "sharedAssetIds",
    "sourceAssets",
    "generationRecords",
    "externalInputs"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "packetId": {"const": "tdf_packet_avian_soarer_visual_source_v001"},
    "sourceVersion": {"const": "tdf-eco-soarer-2026-07-27-v001"},
    "parentRosterSourceVersion": {"const": "tdf-eco-2026-07-27-v001"},
    "createdAtUtc": {"type": "string", "format": "date-time"},
    "promptDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "unity/Docs/Terrestrials/Ecosystems/AvianSoarers/Executed_Generation_Prompts_And_Provenance.md"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terrestrialDesignSource", "runtime", "gameplay", "narrative", "save", "userCreativeApproval"],
      "properties": {
        "terrestrialDesignSource": {"const": true},
        "runtime": {"const": false},
        "gameplay": {"const": false},
        "narrative": {"const": false},
        "save": {"const": false},
        "userCreativeApproval": {"const": false}
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technicalPacketState", "userCreativeState", "runtimeIntegrationState", "narrativeNamingState", "visualQaState"],
      "properties": {
        "technicalPacketState": {"const": "TechnicalReviewReady"},
        "userCreativeState": {"const": "NotRequested"},
        "runtimeIntegrationState": {"const": "Blocked"},
        "narrativeNamingState": {"const": "WorkingLabelsOnly"},
        "visualQaState": {"const": "PassWithConcern"}
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "versionOrModel", "externalInputsSupplied", "editableSourceAvailable", "licenseRecordId"],
      "properties": {
        "product": {"const": "Codex built-in image generation"},
        "versionOrModel": {"const": "unavailable_to_operator"},
        "externalInputsSupplied": {"const": false},
        "editableSourceAvailable": {"const": false},
        "licenseRecordId": {"const": "tdf_license_codex_imagegen_generated_original_v001"}
      }
    },
    "comparisonAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "sourceVersion", "assetId", "usage"],
      "properties": {
        "profileId": {"const": "tdf_boss_crownlands_meridian_tempest_roc"},
        "sourceVersion": {"const": "tdf-rbe-2026-07-24-v001"},
        "assetId": {"const": "tdf_asset_boss_crownlands_meridian_tempest_roc_concept_v002"},
        "usage": {"const": "scale_and_no_reuse_comparison_only"}
      }
    },
    "sourceBudgets": {"$ref": "#/$defs/sourceBudgets"},
    "profiles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/profile"}
    },
    "productionEnvelopes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/envelope"}
    },
    "sharedAssetIds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/tdfId"}
    },
    "sourceAssets": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {"$ref": "#/$defs/asset"}
    },
    "generationRecords": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {"$ref": "#/$defs/record"}
    },
    "externalInputs": {"type": "array", "maxItems": 0}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "tdfId": {"type": "string", "pattern": "^tdf_[a-z0-9_]+$"},
    "stringSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "range": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "number", "exclusiveMinimum": 0}
    },
    "sourceBudgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "ceilings", "actual"],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mediaType", "pixelWidth", "pixelHeight", "colorSpace", "bitDepth", "alphaPolicy", "maximumCompressedBytes", "estimatedDecodedRgbBytes", "maximumDecodedRgbaBytes", "maximumSimultaneousReviewImages", "maximumSimultaneousDecodedBytes"],
          "properties": {
            "mediaType": {"const": "image/png"},
            "pixelWidth": {"const": 1536},
            "pixelHeight": {"const": 1024},
            "colorSpace": {"const": "sRGB"},
            "bitDepth": {"const": 8},
            "alphaPolicy": {"const": "opaque_rgb"},
            "maximumCompressedBytes": {"const": 4194304},
            "estimatedDecodedRgbBytes": {"const": 4718592},
            "maximumDecodedRgbaBytes": {"const": 6291456},
            "maximumSimultaneousReviewImages": {"const": 4},
            "maximumSimultaneousDecodedBytes": {"const": 25165824}
          }
        },
        "ceilings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["finalCount", "finalBytes", "retainedInputCount", "retainedInputBytes", "waveBytes"],
          "properties": {
            "finalCount": {"const": 8},
            "finalBytes": {"const": 33554432},
            "retainedInputCount": {"const": 4},
            "retainedInputBytes": {"const": 16777216},
            "waveBytes": {"const": 50331648}
          }
        },
        "actual": {
          "type": "object",
          "additionalProperties": false,
          "required": ["finalCount", "finalBytes", "retainedInputCount", "retainedInputBytes", "totalCount", "totalBytes", "playerBuildBytes", "runtimeResidentBytes"],
          "properties": {
            "finalCount": {"const": 8},
            "finalBytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
            "retainedInputCount": {"type": "integer", "minimum": 0, "maximum": 4},
            "retainedInputBytes": {"type": "integer", "minimum": 0, "maximum": 16777216},
            "totalCount": {"const": 11},
            "totalBytes": {"type": "integer", "minimum": 1, "maximum": 50331648},
            "playerBuildBytes": {"const": 0},
            "runtimeResidentBytes": {"const": 0}
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "realmId", "state", "qaDisposition", "userDecision", "visualizedVariantId", "pendingVariantIds", "scale", "protectedSilhouette", "materials", "motion", "sharedRigIntent", "primaryAssetIds"],
      "properties": {
        "profileId": {
          "enum": [
            "tdf_fauna_stonehold_rimefan_kite",
            "tdf_fauna_crownlands_stormglass_swift",
            "tdf_fauna_umbral_sootsail_carrioner"
          ]
        },
        "realmId": {"enum": ["stonehold", "crownlands", "umbral"]},
        "state": {"const": "ReadyForUserReview"},
        "qaDisposition": {"enum": ["ProvisionalPass", "PassWithConcern"]},
        "userDecision": {"const": "NotRequested"},
        "visualizedVariantId": {"enum": ["rimefan_open_shelf", "stormglass_high_shelf", "sootsail_rift"]},
        "pendingVariantIds": {"$ref": "#/$defs/stringSet"},
        "scale": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wingspan", "standingHeight", "length", "basis"],
          "properties": {
            "wingspan": {"type": "number", "exclusiveMinimum": 0},
            "standingHeight": {"$ref": "#/$defs/range"},
            "length": {"$ref": "#/$defs/range"},
            "basis": {"const": "adult_champion_height"}
          }
        },
        "protectedSilhouette": {"$ref": "#/$defs/stringSet"},
        "materials": {"$ref": "#/$defs/stringSet"},
        "motion": {"$ref": "#/$defs/stringSet"},
        "sharedRigIntent": {"const": "tdf_rig_avian_soarer"},
        "primaryAssetIds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/tdfId"}
        }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "lowTriangles", "deformBones", "lowTexture", "materialSlotsMaximum", "balancedTrianglesMaximum", "highTrianglesMaximum"],
      "properties": {
        "profileId": {"$ref": "#/$defs/tdfId"},
        "lowTriangles": {"$ref": "#/$defs/range"},
        "deformBones": {"$ref": "#/$defs/range"},
        "lowTexture": {"const": "one_1k_set"},
        "materialSlotsMaximum": {"const": 2},
        "balancedTrianglesMaximum": {"type": "integer", "minimum": 1},
        "highTrianglesMaximum": {"type": "integer", "minimum": 1}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "subjectIds", "roles", "path", "state", "qaDisposition", "byteLength", "sha256", "gitLfsOid", "gitLfsSize", "generationRecordId", "supersedes", "supersededBy"],
      "properties": {
        "assetId": {"$ref": "#/$defs/tdfId"},
        "subjectIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/tdfId"}
        },
        "roles": {"$ref": "#/$defs/stringSet"},
        "path": {
          "type": "string",
          "pattern": "^unity/Docs/Terrestrials/Ecosystems/AvianSoarers/(ConceptSheets|GenerationInputs)/[a-z0-9_]+\\.png$"
        },
        "state": {"enum": ["ReadyForUserReview", "RetainedRefinementInput"]},
        "qaDisposition": {"enum": ["ProvisionalPass", "PassWithConcern", "NotFinal"]},
        "byteLength": {"type": "integer", "minimum": 1, "maximum": 4194304},
        "sha256": {"$ref": "#/$defs/sha256"},
        "gitLfsOid": {"$ref": "#/$defs/sha256"},
        "gitLfsSize": {"type": "integer", "minimum": 1, "maximum": 4194304},
        "generationRecordId": {"$ref": "#/$defs/tdfId"},
        "supersedes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/tdfId"}
        },
        "supersededBy": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/tdfId"}
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generationRecordId", "generatedAtUtc", "inputAssetIds", "outputAssetId"],
      "properties": {
        "generationRecordId": {"$ref": "#/$defs/tdfId"},
        "generatedAtUtc": {"type": "string", "format": "date-time"},
        "inputAssetIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/tdfId"}
        },
        "outputAssetId": {"$ref": "#/$defs/tdfId"}
      }
    }
  }
}
