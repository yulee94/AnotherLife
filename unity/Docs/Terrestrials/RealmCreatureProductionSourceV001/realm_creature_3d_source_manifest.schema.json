{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anotherlife.example/schemas/realm-creature-production-source-v1.schema.json",
  "title": "AnotherLife Realm Creature Production Source Packet V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packetId", "sourceVersion", "createdAtUtc", "authority", "readiness", "qualityBar", "provenance", "unityImportBoundary", "lodPolicy", "summary", "models", "excludedSupersededOutputs"],
  "properties": {
    "schemaVersion": {"const": 1},
    "packetId": {"const": "anotherlife-realm-creature-production-source"},
    "sourceVersion": {"type": "string", "pattern": "^al-rcreature-[0-9]{4}-[0-9]{2}-[0-9]{2}-v[0-9]{3}$"},
    "createdAtUtc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "authority": {"type": "object", "additionalProperties": false, "required": ["finalCreativeApprover", "approved2DSourceVersion", "runtimeAuthority", "gameplayAuthority", "narrativeAuthority"], "properties": {"finalCreativeApprover": {"const": "user"}, "approved2DSourceVersion": {"type": "string"}, "runtimeAuthority": {"const": false}, "gameplayAuthority": {"const": false}, "narrativeAuthority": {"const": false}}},
    "readiness": {"type": "object", "additionalProperties": false, "required": ["technicalPacketState", "userCreativeState", "runtimeIntegrationState", "narrativeNamingState"], "properties": {"technicalPacketState": {"enum": ["TechnicalReviewReady", "TechnicalHandoffComplete"]}, "userCreativeState": {"const": "ApprovedSourceVersion"}, "runtimeIntegrationState": {"const": "Blocked"}, "narrativeNamingState": {"const": "WorkingLabelsOnly"}}},
    "qualityBar": {"type": "object", "additionalProperties": false, "required": ["style", "authoringTextureIntent", "ownerTierTexturePackets", "belowOwnerTierTexturePackets", "coverageDisposition", "runtimeVfxSeparate"], "properties": {"style": {"const": "mystical medieval naturalism"}, "authoringTextureIntent": {"type": "string"}, "ownerTierTexturePackets": {"type": "integer", "minimum": 0, "maximum": 21}, "belowOwnerTierTexturePackets": {"type": "integer", "minimum": 0, "maximum": 21}, "coverageDisposition": {"type": "string", "minLength": 1}, "runtimeVfxSeparate": {"const": true}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["generatorProduct", "generatorModel", "taskBinding", "exactGenerationPromptState", "promptDisposition", "externalInputs", "editingSteps", "licenseEvidence", "editableSourceAvailability"], "properties": {"generatorProduct": {"const": "Meshy"}, "generatorModel": {"type": "string", "minLength": 1}, "taskBinding": {"type": "string", "minLength": 1}, "exactGenerationPromptState": {"const": "not_retained_in_this_packet"}, "promptDisposition": {"type": "string", "minLength": 1}, "externalInputs": {"type": "array", "minItems": 1}, "editingSteps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "licenseEvidence": {"type": "string", "minLength": 1}, "editableSourceAvailability": {"type": "string", "minLength": 1}}},
    "unityImportBoundary": {"type": "object", "additionalProperties": false, "required": ["path", "metaFilesRequired", "importSettingsRequired", "reason"], "properties": {"path": {"const": "outside_unity_assets"}, "metaFilesRequired": {"const": false}, "importSettingsRequired": {"const": false}, "reason": {"type": "string", "minLength": 1}}},
    "lodPolicy": {"type": "object", "additionalProperties": false, "required": ["sourceTierMaximumTriangles", "balancedLodMaximumTriangles", "lowMobileLodMaximumTriangles", "requiredDerivatives", "deliveryState"], "properties": {"sourceTierMaximumTriangles": {"const": 75000}, "balancedLodMaximumTriangles": {"const": 45000}, "lowMobileLodMaximumTriangles": {"const": 22000}, "requiredDerivatives": {"const": ["LOD1", "LOD2"]}, "deliveryState": {"const": "Blocked_not_generated_or_validated"}}},
    "summary": {"type": "object", "additionalProperties": false, "required": ["approved2D", "structuralPass", "blocked3D", "ownerTierTexturePackets", "belowOwnerTierTexturePackets", "runtimeIntegrationState"], "properties": {"approved2D": {"const": 21}, "structuralPass": {"type": "integer", "minimum": 0, "maximum": 21}, "blocked3D": {"type": "integer", "minimum": 0, "maximum": 21}, "ownerTierTexturePackets": {"type": "integer", "minimum": 0, "maximum": 21}, "belowOwnerTierTexturePackets": {"type": "integer", "minimum": 0, "maximum": 21}, "runtimeIntegrationState": {"const": "Blocked"}}},
    "models": {"type": "array", "minItems": 21, "maxItems": 21, "items": {"$ref": "#/$defs/model"}},
    "excludedSupersededOutputs": {"const": true}
  },
  "$defs": {
    "file": {"type": "object", "additionalProperties": true, "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "model": {"type": "object", "additionalProperties": false, "required": ["source2dId", "modelId", "status", "blocker", "selectedSource", "textures", "review", "meshyTaskIds", "rigged", "runtimeIntegrationState", "productionReady"], "properties": {"source2dId": {"type": "string", "minLength": 1}, "modelId": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"}, "status": {"type": "string", "minLength": 1}, "blocker": {"type": ["string", "null"]}, "selectedSource": {"$ref": "#/$defs/file"}, "textures": {"type": "array", "items": {"$ref": "#/$defs/file"}}, "review": {"$ref": "#/$defs/file"}, "meshyTaskIds": {"type": "array", "items": {"type": "string"}}, "rigged": {"const": false}, "runtimeIntegrationState": {"const": "Blocked"}, "productionReady": {"const": false}}}
  }
}
