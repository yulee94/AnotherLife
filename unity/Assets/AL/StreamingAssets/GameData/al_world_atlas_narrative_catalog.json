    { "key": "world.zone.warzone_stonehold_gate.name", "text": "Stonehold Faultline Gate" },
    { "key": "world.zone.warzone_stonehold_gate.summary", "text": "A mountain gate built for attrition, siege discipline, and contested gem routes." },
    { "key": "world.zone.warzone_eldergrove_gate.name", "text": "Eldergrove Greenveil Gate" },
    { "key": "world.zone.warzone_eldergrove_gate.summary", "text": "A living border gate where ambush paths and sanctuary vows meet open conflict." },
    { "key": "world.zone.warzone_umbral_gate.name", "text": "Umbral Ashvein Gate" },
    { "key": "world.zone.warzone_umbral_gate.summary", "text": "A veiled warzone gate shaped by ash routes, intelligence denial, and precision strikes." },
    { "key": "world.zone.crossroads_bridges.name", "text": "Bridge Crossroads" },
