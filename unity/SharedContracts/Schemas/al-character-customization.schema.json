{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://another-life.local/schemas/al-character-customization.schema.json",
  "title": "Another Life Character Customization Catalog",
  "type": "object",
  "required": ["version", "game", "characterSlots", "bodyPresets", "hairStyles", "armorStyles", "primaryColors", "hairColors", "skinColors", "eyeColors", "accentColors", "faceMarks", "weaponStyles", "offhandStyles", "forgePresets", "realms", "qualityTargets"],
  "properties": {
    "version": {
      "type": "string"
    },
    "game": {
      "type": "string"
    },
    "characterSlots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "bodyPresets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bodyPreset"
      },
      "minItems": 1
    },
    "hairStyles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/styleOption"
      },
      "minItems": 1
    },
    "armorStyles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/styleOption"
      },
      "minItems": 1
    },
    "primaryColors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/colorOption"
      },
      "minItems": 1
    },
    "hairColors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/colorOption"
      },
      "minItems": 1
    },
    "skinColors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/colorOption"
      },
      "minItems": 1
    },
    "eyeColors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/colorOption"
      },
      "minItems": 1
    },
    "accentColors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/colorOption"
      },
      "minItems": 1
    },
    "faceMarks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/styleOption"
      },
      "minItems": 1
    },
    "weaponStyles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/styleOption"
      },
      "minItems": 1
    },
    "offhandStyles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/styleOption"
      },
      "minItems": 1
    },
    "forgePresets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/forgePreset"
      },
      "minItems": 1
    },
    "realms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/realmCustomization"
      },
      "minItems": 1
    },
    "qualityTargets": {
      "$ref": "#/$defs/qualityTargets"
    }
  },
  "$defs": {
    "bodyPreset": {
      "type": "object",
      "required": ["id", "displayName", "scale"],
      "properties": {
        "id": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "scale": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "additionalProperties": false
    },
    "styleOption": {
      "type": "object",
      "required": ["id", "displayName"],
      "properties": {
        "id": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "colorOption": {
      "type": "object",
      "required": ["id", "displayName", "rgb"],
      "properties": {
        "id": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "rgb": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "additionalProperties": false
    },
    "rgbColor": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 3,
      "maxItems": 3
    },
    "forgePreset": {
      "type": "object",
      "required": ["id", "displayName", "summary", "bodyPresetId", "hairStyleId", "armorStyleId", "faceMarkId", "weaponStyleId", "offhandStyleId", "primaryColor", "hairColor", "skinColor", "eyeColor", "accentColor", "capeEnabled", "helmetEnabled"],
      "properties": {
        "id": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "bodyPresetId": {
          "type": "string"
        },
        "hairStyleId": {
          "type": "string"
        },
        "armorStyleId": {
          "type": "string"
        },
        "faceMarkId": {
          "type": "string"
        },
        "weaponStyleId": {
          "type": "string"
        },
        "offhandStyleId": {
          "type": "string"
        },
        "primaryColor": {
          "$ref": "#/$defs/rgbColor"
        },
        "hairColor": {
          "$ref": "#/$defs/rgbColor"
        },
        "skinColor": {
          "$ref": "#/$defs/rgbColor"
        },
        "eyeColor": {
          "$ref": "#/$defs/rgbColor"
        },
        "accentColor": {
          "$ref": "#/$defs/rgbColor"
        },
        "capeEnabled": {
          "type": "boolean"
        },
        "helmetEnabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "realmCustomization": {
      "type": "object",
      "required": ["id", "displayName", "materialKeys", "customizationFocus"],
      "properties": {
        "id": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "materialKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "customizationFocus": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "qualityTargets": {
      "type": "object",
      "required": ["heroTriangles", "mediumTriangles", "lowTriangles", "farRepresentation"],
      "properties": {
        "heroTriangles": {
          "type": "string"
        },
        "mediumTriangles": {
          "type": "string"
        },
        "lowTriangles": {
          "type": "string"
        },
        "farRepresentation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
