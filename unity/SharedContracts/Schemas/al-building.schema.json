{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://another-life.local/schemas/al-building.schema.json",
  "title": "Another Life Building Art Binding Catalog",
  "type": "object",
  "required": ["version", "catalogId", "game", "idFormat", "buildings"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "catalogId": {
      "const": "al_building_catalog"
    },
    "game": {
      "const": "Another Life"
    },
    "idFormat": {
      "const": "lowercase_snake_case"
    },
    "buildings": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "$ref": "#/$defs/building"
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
      "description": "Matches GameDataCatalogIdentifiers.IsCanonicalStableId: lowercase snake_case, no leading/double/trailing underscore, length <= 128."
    },
    "contentRef": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*(\\.[a-z][a-z0-9]*(_[a-z0-9]+)*)+$",
      "description": "Dot-separated stable IDs. Matches IsCanonicalContentReference."
    },
    "assetReference": {
      "type": "object",
      "required": ["path", "guid", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^Assets/(?:[A-Za-z0-9_-]+/)+[A-Za-z0-9_.-]+$",
          "description": "Project-relative asset path. Forward slashes, starts with Assets/, no '..', no backslash."
        },
        "guid": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "building": {
      "type": "object",
      "required": ["id", "legacy_building_id", "name_ref", "models"],
      "properties": {
        "id": {
          "enum": [
            "town_hall",
            "farm",
            "lumber_mill",
            "quarry",
            "gold_mine",
            "barracks",
            "academy",
            "market",
            "storehouse",
            "forge",
            "stable",
            "workshop",
            "embassy",
            "wall",
            "watchtower"
          ]
        },
        "legacy_building_id": {
          "enum": [
            "TownHall",
            "Farm",
            "LumberMill",
            "Quarry",
            "GoldMine",
            "Barracks",
            "Academy",
            "Market",
            "Storehouse",
            "Forge",
            "Stable",
            "Workshop",
            "Embassy",
            "Wall",
            "Watchtower"
          ]
        },
        "name_ref": {
          "$ref": "#/$defs/contentRef"
        },
        "models": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/buildingModelRef"
          }
        }
      },
      "additionalProperties": false
    },
    "buildingModelRef": {
      "type": "object",
      "required": ["realm_id", "model_id", "asset_ref"],
      "properties": {
        "realm_id": {
          "enum": ["crownlands", "stonehold", "eldergrove", "umbral"]
        },
        "model_id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^building_[a-z][a-z0-9]*(_[a-z0-9]+)*_v[1-9][0-9]*$"
        },
        "asset_ref": {
          "$ref": "#/$defs/assetReference"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
