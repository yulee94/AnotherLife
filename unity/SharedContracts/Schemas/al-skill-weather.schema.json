{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://another-life.local/schemas/al-skill-weather.schema.json",
  "title": "Another Life Skill And Weather Catalog",
  "type": "object",
  "required": ["version", "skillLoadouts", "skillEffects", "weatherProfiles"],
  "properties": {
    "version": {
      "type": "string"
    },
    "skillLoadouts": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/skillLoadout"
      }
    },
    "skillEffects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skillEffect"
      }
    },
    "weatherProfiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/weatherProfile"
      }
    }
  },
  "$defs": {
    "skillLoadout": {
      "type": "object",
      "required": [
        "slot",
        "id",
        "displayName",
        "role",
        "vfxKey",
        "cooldownSeconds",
        "manaCost",
        "castTimeSeconds",
        "rangeMeters",
        "power",
        "botDamageMultiplier"
      ],
      "properties": {
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "id": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "vfxKey": {
          "type": "string"
        },
        "cooldownSeconds": {
          "type": "number",
          "minimum": 0
        },
        "manaCost": {
          "type": "number",
          "minimum": 0
        },
        "castTimeSeconds": {
          "type": "number",
          "minimum": 0
        },
        "rangeMeters": {
          "type": "number",
          "minimum": 0
        },
        "power": {
          "type": "number",
          "minimum": 0
        },
        "botDamageMultiplier": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "skillEffect": {
      "type": "object",
      "required": ["key", "realm", "use", "colors"],
      "properties": {
        "key": {
          "type": "string"
        },
        "realm": {
          "type": "string"
        },
        "use": {
          "type": "string"
        },
        "colors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "weatherProfile": {
      "type": "object",
      "required": [
        "key",
        "realm",
        "displayName",
        "particles",
        "color",
        "particleStartColor",
        "particleEndColor",
        "maxParticles",
        "radius",
        "fallSpeed",
        "particleSize",
        "particleLifetime",
        "emissionRateMultiplier",
        "horizontalDrift",
        "noiseStrength",
        "noiseFrequency",
        "wind",
        "lighting",
        "lightning"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "realm": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "particles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "color": {
          "$ref": "#/$defs/rgba"
        },
        "particleStartColor": {
          "$ref": "#/$defs/rgba"
        },
        "particleEndColor": {
          "$ref": "#/$defs/rgba"
        },
        "maxParticles": {
          "type": "integer",
          "minimum": 1
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fallSpeed": {
          "type": "number",
          "minimum": 0
        },
        "particleSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "particleLifetime": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "emissionRateMultiplier": {
          "type": "number",
          "minimum": 0
        },
        "horizontalDrift": {
          "type": "number",
          "minimum": 0
        },
        "noiseStrength": {
          "type": "number",
          "minimum": 0
        },
        "noiseFrequency": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "wind": {
          "$ref": "#/$defs/windProfile"
        },
        "lighting": {
          "$ref": "#/$defs/lightingProfile"
        },
        "lightning": {
          "$ref": "#/$defs/lightningProfile"
        }
      },
      "additionalProperties": false
    },
    "rgba": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 4,
      "maxItems": 4
    },
    "windProfile": {
      "type": "object",
      "required": ["yawDegrees", "main", "turbulence", "pulseAmplitude", "pulseFrequency"],
      "properties": {
        "yawDegrees": {
          "type": "number"
        },
        "main": {
          "type": "number",
          "minimum": 0
        },
        "turbulence": {
          "type": "number",
          "minimum": 0
        },
        "pulseAmplitude": {
          "type": "number",
          "minimum": 0
        },
        "pulseFrequency": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "lightingProfile": {
      "type": "object",
      "required": ["applyFog", "fogColor", "fogDensity", "ambientColor", "directionalLightColor", "directionalLightIntensity"],
      "properties": {
        "applyFog": {
          "type": "boolean"
        },
        "fogColor": {
          "$ref": "#/$defs/rgba"
        },
        "fogDensity": {
          "type": "number",
          "minimum": 0
        },
        "ambientColor": {
          "$ref": "#/$defs/rgba"
        },
        "directionalLightColor": {
          "$ref": "#/$defs/rgba"
        },
        "directionalLightIntensity": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "lightningProfile": {
      "type": "object",
      "required": ["enabled", "color", "flashIntensity", "duration", "minDelay", "maxDelay"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "color": {
          "$ref": "#/$defs/rgba"
        },
        "flashIntensity": {
          "type": "number",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minDelay": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxDelay": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
