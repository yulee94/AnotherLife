{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://another-life.local/schemas/al-item-power-ladders.schema.json",
  "title": "Another Life Item Power Ladders Catalog",
  "description": "Exact owner-locked PvP, PvE, special-heart, embed-gem, and accessory authority. Lower ranks are stronger. Numeric drop rates, gem roll curves, and stat budgets are intentionally unspecified.",
  "type": "object",
  "required": [
    "schemaVersion",
    "catalogId",
    "gameId",
    "rankingRule",
    "universalBestGearSource",
    "unspecifiedPolicies",
    "pvpGearLadder",
    "pveGearLadder",
    "specialHearts",
    "attributeCapacityPercent",
    "embedGemLadder",
    "accessoryLadder",
    "nonClaims"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogId": { "const": "al_item_power_ladders_catalog" },
    "gameId": { "const": "another-life" },
    "rankingRule": { "const": "lower_rank_is_stronger" },
    "universalBestGearSource": { "const": "awakened_warmaster" },
    "unspecifiedPolicies": {
      "const": ["drop_rates", "gem_roll_curves", "stat_budgets"]
    },
    "pvpGearLadder": {
      "const": [
        { "rank": 1, "source": "awakened_warmaster", "awakening": "awakened" },
        { "rank": 2, "source": "dragon", "awakening": "awakened" },
        { "rank": 3, "source": "outer_realm_dungeon_loot", "awakening": "awakened" },
        { "rank": 4, "source": "inner_realm_dungeon_loot", "awakening": "awakened" },
        { "rank": 5, "source": "level_50_creature_loot", "awakening": "awakened" }
      ]
    },
    "pveGearLadder": {
      "const": [
        { "rank": 1, "source": "awakened_warmaster", "awakening": "awakened" },
        { "rank": 2, "source": "user_crafted", "awakening": "awakened" },
        { "rank": 3, "source": "elite_boss_loot", "awakening": "awakened" }
      ]
    },
    "specialHearts": {
      "const": [
        {
          "id": "center_isle_wish_dragon_heart",
          "itemCategory": "center_inventory_equipment",
          "regularGearSlotEligible": false,
          "acquisition": {
            "requirementsMode": "all",
            "realmUniqueGemCount": 8,
            "arenaVictory": "accordant_center_isle_realm_ffa",
            "championMayWishForItem": true
          }
        },
        {
          "id": "world_boss_event_boss_heart",
          "itemCategory": "center_inventory_equipment",
          "regularGearSlotEligible": false,
          "acquisition": {
            "dropFrequency": "extremely_low",
            "contributorLootPercentagePolicy": "equal_for_every_contributor"
          }
        }
      ]
    },
    "attributeCapacityPercent": {
      "const": { "minimum": 1, "maximum": 100 }
    },
    "embedGemLadder": {
      "const": [
        { "rank": 1, "source": "dragon", "minimumPercent": 91, "maximumPercent": 100, "rollPolicy": "range" },
        { "rank": 2, "source": "elite_boss", "minimumPercent": 51, "maximumPercent": 90, "rollPolicy": "range" },
        { "rank": 3, "source": "crafted", "minimumPercent": 75, "maximumPercent": 75, "rollPolicy": "fixed" },
        { "rank": 4, "source": "regular_creature", "minimumPercent": 30, "maximumPercent": 50, "rollPolicy": "range" }
      ]
    },
    "accessoryLadder": {
      "const": [
        { "rank": 1, "source": "dragon" },
        { "rank": 2, "source": "elite_boss" },
        { "rank": 3, "source": "crafted" },
        { "rank": 4, "source": "quest_given", "tradable": false },
        { "rank": 5, "source": "regular_creature" }
      ]
    },
    "nonClaims": {
      "const": ["2.5d_gameplay", "mobile_readiness", "live_numeric_economy"]
    }
  },
  "additionalProperties": false
}
