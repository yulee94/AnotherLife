{
  "schemaVersion": 1,
  "version": "1.1.0",
  "catalogId": "al_guild_membership_policy",
  "game": "Another Life",
  "sourceRevision": "guild_membership_policy_v2",
  "machineIdentity": "Guild",
  "playerFacingTerms": { "primary": "Guild", "presentationAlias": "Clan", "aliasScope": "localization_only" },
  "membershipScope": { "subject": "account", "realmBinding": "immutable_account_realm", "sameRealmCharactersShareMembership": true, "crossGuildUniqueness": "one_reserving_membership_per_account", "requiredActiveMasterCount": 2, "joinedRole": "Member" },
  "roles": [
    { "role": "Master", "canManageInvitations": true, "canManageMembers": true, "canPromote": true, "canDemote": true, "canTransferMaster": true, "canDisband": true, "canFormAlliancesOrDeclareWar": true, "canOpenRaidCalls": true },
    { "role": "Officer", "canManageInvitations": true, "canManageMembers": true, "canPromote": false, "canDemote": false, "canTransferMaster": false, "canDisband": false, "canFormAlliancesOrDeclareWar": false, "canOpenRaidCalls": true },
    { "role": "Member", "canManageInvitations": false, "canManageMembers": false, "canPromote": false, "canDemote": false, "canTransferMaster": false, "canDisband": false, "canFormAlliancesOrDeclareWar": false, "canOpenRaidCalls": false }
  ],
  "membershipStates": [
    { "state": "Active", "reservesAccount": true, "grantsRoleAuthority": true, "leaveResult": "PendingLeave", "kickResult": "Banned", "blocksSameGuildEntry": true },
    { "state": "Restricted", "reservesAccount": true, "grantsRoleAuthority": false, "leaveResult": "PendingLeave", "kickResult": "Banned", "blocksSameGuildEntry": true },
    { "state": "PendingLeave", "reservesAccount": true, "grantsRoleAuthority": false, "leaveResult": "Inactive", "kickResult": null, "blocksSameGuildEntry": true },
    { "state": "Banned", "reservesAccount": false, "grantsRoleAuthority": false, "leaveResult": null, "kickResult": null, "blocksSameGuildEntry": true },
    { "state": "Inactive", "reservesAccount": false, "grantsRoleAuthority": false, "leaveResult": null, "kickResult": null, "blocksSameGuildEntry": false }
  ],
  "membershipStatePolicy": { "revisionFence": "exact_authority_and_guild_revisions", "unknownState": "preserve_read_only", "bannedScope": "same_guild_cycle" },
  "transitions": ["create", "join", "invite", "accept", "decline", "leave", "kick", "promote", "demote", "master_transfer", "disband"],
  "pendingRequestPolicy": { "joinApplicationResolution": "master_or_officer", "invitationResolution": "invited_account_or_manager_cancel", "membershipChangeFence": "accept_exact_guild_revision", "terminalResolution": "accept_xor_decline" },
  "replayPolicy": { "operationIdentity": "operation_id", "sameFingerprint": "already_committed", "differentFingerprint": "conflict", "unknownOutcome": "fail_closed_until_reconciled" },
  "excludedEffectDomains": ["combat", "economy", "perk", "city", "raid"],
  "authorityBoundary": { "plannerScope": "engine_free_snapshot_only", "excludedImplementations": ["persistence", "network", "save", "combat", "economy", "perk", "city", "raid"] }
}
