{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anotherlife.example/contracts/release-evidence-package.schema.json",
  "title": "AnotherLife Release Evidence Package",
  "description": "Approval-ready, fail-closed release evidence catalog. Numerical release and capacity criteria remain external task references.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "promotionStatus",
    "sourceRevision",
    "qaRun",
    "authorityReferences",
    "controlArtifacts",
    "sourceAuthorities",
    "upstreamEvidence",
    "ownerDecisions",
    "compatibilityExceptions",
    "manualOwnerGates",
    "stopShipConditions",
    "reopenTriggers",
    "qaContracts",
    "artifacts",
    "rollbackSafety",
    "packageSha256"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "packageId": {"const": "anotherlife-release-evidence"},
    "promotionStatus": {"const": "awaiting_release_owner_approval"},
    "sourceRevision": {"$ref": "#/$defs/gitObject"},
    "qaRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reportSha256", "profile", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^qa-[0-9a-f]{20}$"},
        "reportSha256": {"$ref": "#/$defs/sha256"},
        "profile": {"const": "full"},
        "status": {"const": "passed"}
      }
    },
    "authorityReferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvalDependencyTask", "releaseCriteriaTask", "capacityCriteriaTask"],
      "properties": {
        "approvalDependencyTask": {"const": "t_0648ce23"},
        "releaseCriteriaTask": {"const": "t_4a5b066c"},
        "capacityCriteriaTask": {"const": "t_7f6be100"}
      }
    },
    "controlArtifacts": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "sourceAuthorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "sha256", "gitBlob"],
        "properties": {
          "role": {"$ref": "#/$defs/nonBlank"},
          "path": {"$ref": "#/$defs/relativePath"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "gitBlob": {"$ref": "#/$defs/gitObject"}
        }
      }
    },
    "upstreamEvidence": {"type": "array", "minItems": 5, "items": {"type": "object"}},
    "ownerDecisions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "compatibilityExceptions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "manualOwnerGates": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "stopShipConditions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "reopenTriggers": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "qaContracts": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "failureCode", "status", "reasonCode", "evidence"],
        "properties": {
          "id": {"$ref": "#/$defs/nonBlank"},
          "failureCode": {"type": "string", "pattern": "^QA_[A-Z0-9_]+$"},
          "status": {"const": "passed"},
          "reasonCode": {"$ref": "#/$defs/nonBlank"},
          "evidence": {"type": "object"}
        }
      }
    },
    "artifacts": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/artifact"}},
    "rollbackSafety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buildDataPairRestore", "saveBackupRetention", "schemaRollback"],
      "properties": {
        "buildDataPairRestore": {"const": "same_verified_manifest_and_supported_save_schema_only"},
        "saveBackupRetention": {"const": "byte_exact_until_release_owner_closes_migration_observation"},
        "schemaRollback": {"const": "not_approved_without_new_bidirectional_fixture_proof"}
      }
    },
    "packageSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "nonBlank": {"type": "string", "minLength": 1},
    "relativePath": {"type": "string", "minLength": 1, "not": {"pattern": "^(?:[A-Za-z]:|/|\\\\)"}},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitObject": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256"],
      "properties": {
        "role": {"$ref": "#/$defs/nonBlank"},
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
